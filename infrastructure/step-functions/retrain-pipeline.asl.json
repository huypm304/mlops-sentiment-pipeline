{
  "Comment": "ABSA MLOps retraining workflow: Upload → Audit → Clean → Train → Evaluate → Register → Deploy",
  "StartAt": "Upload",
  "States": {
    "Upload": {
      "Type": "Pass",
      "Comment": "Dataset path recorded under s3://${artifacts_bucket}/datasets/",
      "Parameters": {
        "stage": "upload",
        "bucket": "${artifacts_bucket}",
        "dataset_key.$": "$.dataset_key",
        "uploaded_at.$": "$$.State.EnteredTime"
      },
      "ResultPath": "$.upload",
      "Next": "Audit"
    },
    "Audit": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Run dataset quality audit (BIO, spans, polarity, duplicates)",
      "Parameters": {
        "FunctionName": "${audit_lambda_arn}",
        "Payload": {
          "action": "audit",
          "bucket": "${artifacts_bucket}",
          "dataset_key.$": "$.dataset_key",
          "upload.$": "$.upload"
        }
      },
      "ResultPath": "$.audit",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "AuditFailed"
        }
      ],
      "Next": "Clean"
    },
    "Clean": {
      "Type": "Pass",
      "Comment": "Normalize and clean audited dataset; output to datasets/clean/",
      "Parameters": {
        "stage": "clean",
        "bucket": "${artifacts_bucket}",
        "clean_prefix": "datasets/clean/",
        "audit.$": "$.audit"
      },
      "ResultPath": "$.clean",
      "Next": "Train"
    },
    "Train": {
      "Type": "Pass",
      "Comment": "SageMaker training job placeholder — wire CreateTrainingJob in production",
      "Parameters": {
        "stage": "train",
        "training_job_name": "${project_name}-train",
        "output_prefix": "models/runs/",
        "clean.$": "$.clean"
      },
      "ResultPath": "$.train",
      "Next": "Evaluate"
    },
    "Evaluate": {
      "Type": "Pass",
      "Comment": "Evaluate best checkpoint; write metrics to evaluation/",
      "Parameters": {
        "stage": "evaluate",
        "metrics_prefix": "evaluation/",
        "artifacts": [
          "metrics.json",
          "confusion_matrix.png",
          "training_curves.png"
        ],
        "train.$": "$.train"
      },
      "ResultPath": "$.evaluation",
      "Next": "Register"
    },
    "Register": {
      "Type": "Pass",
      "Comment": "Register model version under models/ and artifacts/",
      "Parameters": {
        "stage": "register",
        "model_key": "models/latest/best_model.pt",
        "report_key": "reports/training-summary.json",
        "evaluation.$": "$.evaluation"
      },
      "ResultPath": "$.registry",
      "Next": "Deploy"
    },
    "Deploy": {
      "Type": "Pass",
      "Comment": "Deploy or update SageMaker endpoint (demo: mark deployment requested)",
      "Parameters": {
        "stage": "deploy",
        "endpoint_name": "${project_name}-endpoint",
        "status": "deployment_requested",
        "registry.$": "$.registry"
      },
      "ResultPath": "$.deploy",
      "Next": "Succeeded"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "AuditFailed": {
      "Type": "Fail",
      "Error": "AuditFailed",
      "Cause": "Dataset audit did not pass quality gates."
    }
  }
}
