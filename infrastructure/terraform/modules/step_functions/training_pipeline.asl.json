{
  "Comment": "ABSA retrain pipeline — dataset pre-audited manually: Train → Evaluate → Register → Notify",
  "StartAt": "StartTraining",
  "States": {
    "StartTraining": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Launch training (mock Lambda or SageMaker job).",
      "Parameters": {
        "FunctionName": "${pipeline_lambda_arn}",
        "Payload": {
          "action": "start_training",
          "run_id.$": "$.run_id",
          "created_at.$": "$.created_at",
          "dataset_id.$": "$.dataset_id",
          "dataset_key.$": "$.dataset_key",
          "dataset_s3_uri.$": "$.dataset_s3_uri",
          "training_config.$": "$.training_config",
          "base_model_id.$": "$.base_model_id",
          "candidate_model_id.$": "$.candidate_model_id",
          "artifacts_bucket": "${artifacts_bucket}"
        }
      },
      "ResultPath": "$.training",
      "TimeoutSeconds": 14400,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 1,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "EvaluateCandidate"
    },
    "EvaluateCandidate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Evaluate candidate model on dev split (real metrics when SageMaker training is enabled).",
      "Parameters": {
        "FunctionName": "${pipeline_lambda_arn}",
        "Payload": {
          "action": "evaluate",
          "run_id.$": "$.run_id",
          "candidate_model_id.$": "$.candidate_model_id",
          "training.$": "$.training.Payload",
          "artifacts_bucket": "${artifacts_bucket}"
        }
      },
      "ResultPath": "$.evaluation",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 10,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "RegisterCandidate"
    },
    "RegisterCandidate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Register candidate in model registry.",
      "Parameters": {
        "FunctionName": "${pipeline_lambda_arn}",
        "Payload": {
          "action": "register_model",
          "run_id.$": "$.run_id",
          "candidate_model_id.$": "$.candidate_model_id",
          "evaluation.$": "$.evaluation.Payload",
          "artifacts_bucket": "${artifacts_bucket}"
        }
      },
      "ResultPath": "$.registry",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyFailure"
        }
      ],
      "Next": "NotifyResult"
    },
    "NotifyResult": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Comment": "Persist final run status.",
      "Parameters": {
        "FunctionName": "${pipeline_lambda_arn}",
        "Payload": {
          "action": "notify",
          "run_id.$": "$.run_id",
          "candidate_model_id.$": "$.candidate_model_id",
          "evaluation.$": "$.evaluation.Payload",
          "registry.$": "$.registry.Payload",
          "outcome": "COMPLETED"
        }
      },
      "ResultPath": "$.notify",
      "Next": "PipelineSucceeded"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${pipeline_lambda_arn}",
        "Payload": {
          "action": "notify",
          "run_id.$": "$.run_id",
          "outcome": "FAILED",
          "reason.$": "$.error"
        }
      },
      "ResultPath": "$.notify",
      "Next": "PipelineFailed"
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "Training pipeline failed. Check CloudWatch logs and training run record."
    }
  }
}
