# Copy to terraform.tfvars and fill in real values.
# cp terraform.tfvars.example terraform.tfvars

aws_region  = "ap-southeast-1"
project     = "absa-mlops"
environment = "demo"
owner       = "minh-huy"

# GitHub OIDC — must match your repository exactly
github_org  = "your-github-username"
github_repo = "mlops-sentiment-pipeline"

deploy_branches = ["refactor/terraform-bootstrap-core-runtime"]

# Budget alert — set to 0 to disable
monthly_budget_usd = 20
budget_alert_email = "your-email@example.com"
