# =============================================================================
# ABSA MLOps Platform — root .gitignore
# =============================================================================

# --- OS & editors ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
*.deb

# --- Secrets & env (never commit) ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
credentials.json
secrets.json
.gh-headers.txt

# --- Generated / local-only docs ---
REFACTOR_REPORT.md

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
/venv
venv/
env/
ENV/
backend/venv/
backend/env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/

# --- ML / model artifacts (large binaries) ---
*.pt
*.pth
*.onnx
*.safetensors
model/*.pt
model/checkpoints/
model/train_log.csv
model/confusion_matrices.jsonl
training/runs/
training/outputs/
wandb/
mlruns/
lightning_logs/
*.ckpt

# Regenerate with scripts/export_model_artifacts.py and upload to S3
final_artifacts/
!final_artifacts/.gitkeep

# --- Frontend (Next.js) ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.turbo/
frontend/.vercel/
frontend/.npm/
frontend/.eslintcache
frontend/.vite/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# --- Terraform & IaC ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
# Local secrets / per-machine vars (keep *.example)
terraform.tfvars
**/terraform.tfvars
!terraform.tfvars.example
!**/terraform.tfvars.example
# Lambda zip artifacts from terraform archive / deploy
infrastructure/terraform/modules/lambda/build/
infrastructure/terraform/modules/lambda_function/build/
*.zip

# --- Deploy / CI build output ---
.build/
lambda/.build/

# --- Archives & dumps ---
*.tar.gz
*.tgz
*.zip
!infrastructure/**/*.zip.example

# --- Audit reports (generated locally; optional commit for demo) ---
reports/audit/*.json
reports/monitoring/*.json
reports/monitoring/*.jsonl
datasets/local/

# --- DVC (local cache; .dvc/config is committed) ---
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
.cache/

# --- Cursor / AI agent (local IDE — do not commit) ---
.cursor/
.cursor/rules/
.cursorrules
.agents/
skills-config.json
skills-lock.json

# Agent instruction files (Cursor, Claude Code, Copilot, etc.)
AGENTS.md
AGENT.md
CLAUDE.md
**/AGENTS.md
**/CLAUDE.md
**/SKILL.md

# Agent guides, prompts, and skill docs (local AI workflow)
docs/agent/
absa_mlops_agent_docs/
06_COPY_PASTE_AGENT_PROMPTS.md
**/06_COPY_PASTE_AGENT_PROMPTS.md

# Optional tool-specific agent dirs
.codex/
.continue/

# --- Legacy / typo paths (safe to ignore if present) ---
aws/terrafrom/
