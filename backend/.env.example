# Local inference API (default — no AWS required)
ABSA_MODEL_DIR=./model
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — connect backend to AWS DynamoDB + Step Functions (demo/deploy)
AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

ARTIFACTS_BUCKET=absa-mlops-demo-artifacts
RETRAIN_STATE_MACHINE_ARN=arn:aws:states:ap-southeast-1:ACCOUNT:stateMachine:absa-mlops-demo-retrain

DATASETS_TABLE=absa-mlops-demo-datasets
TRAINING_RUNS_TABLE=absa-mlops-demo-training-runs
MODELS_TABLE=absa-mlops-demo-models
PREDICTIONS_TABLE=absa-mlops-demo-predictions
MONITORING_TABLE=absa-mlops-demo-monitoring-snapshots
APPROVAL_TABLE=absa-mlops-demo-approval-requests
REVIEW_QUEUE_TABLE=absa-mlops-demo-review-queue
